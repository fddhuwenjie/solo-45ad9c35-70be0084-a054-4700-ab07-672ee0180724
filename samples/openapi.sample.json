  "components": {
    "schemas": {
      "AppendEntriesIn": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryIn"
            },
            "type": "array",
            "minItems": 1,
            "title": "Entries"
          },
          "operator": {
