        "type": "object",
        "required": [
          "entries"
        ],
        "title": "AppendEntriesIn"
      },
      "CorrectIn": {
        "properties": {
          "case_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case No"
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Id"
          },
          "collected_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected At"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "operator": {
            "type": "string",
            "minLength": 1,
            "title": "Operator",
            "description": "发起更正的操作者"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason",
            "description": "更正原因，写入审计"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryIn"
            },
            "type": "array",
            "title": "Entries",
            "description": "更正后新版本的完整条目集"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "operator",
          "reason",
          "entries"
        ],
        "title": "CorrectIn",
        "description": "对已封存版本发起更正，生成同 lineage 的新版本（新版本初始为 open）。"
      },
      "EntryIn": {
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "title": "Path",
            "description": "文件在介质中的路径"
          },
          "size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size",
            "description": "字节数"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256",
            "description": "整文件 SHA-256"
          },
          "chunk_size": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Size",
            "description": "分块大小（字节）"
          },
          "chunk_hashes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
